{
  "name": "@confri/ui-mobile",
  "version": "0.0.0",
  "private": true,
  "description": "ConvoyFriends mobile UI primitives + NativeWind v4 theme. Mirrors @confri/ui-web component vocabulary on React Native.",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./nativewind": "./nativewind.css",
    "./nativewind.css": "./nativewind.css",
    "./helpers": {
      "types": "./src/helpers/index.ts",
      "import": "./src/helpers/index.ts"
    }
  },
  "files": [
    "src",
    "nativewind.css"
  ],
  "scripts": {
    "build": "pnpm build:theme",
    "build:theme": "tsx scripts/build-theme.ts",
    "dev": "pnpm build:theme",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf nativewind.css"
  },
  "dependencies": {
    "@confri/tokens": "workspace:*"
  },
  "peerDependencies": {
    "expo-linear-gradient": ">=13",
    "nativewind": ">=4",
    "react": ">=18",
    "react-native": ">=0.74",
    "react-native-svg": ">=15",
    "tailwindcss": ">=4"
  },
  "peerDependenciesMeta": {
    "expo-linear-gradient": {
      "optional": true
    },
    "react-native-svg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@react-native-masked-view/masked-view": "^0.3.2",
    "@storybook/react": "^8.6.18",
    "@types/react": "^19.0.0",
    "@types/react-native": "^0.73.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "expo-linear-gradient": "^14.1.5",
    "nativewind": "^4.0.0",
    "react": "^19.0.0",
    "react-native": "^0.76.9",
    "react-native-svg": "^15.0.0"
  }
}
