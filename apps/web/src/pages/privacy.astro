---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
---

<BaseLayout title="Privacy Policy — ConvoyFriends" description="ConvoyFriends privacy policy.">
  <SiteHeader />
  <main class="pt-28 pb-24">
    <div class="mx-auto max-w-2xl px-6">
      <h1 class="font-display font-extrabold text-h1 tracking-tight mb-4">Privacy Policy</h1>
      <p class="text-lede text-ink-mute mb-8">Effective date: 2026-01-01</p>
      <p class="text-body text-ink-mute leading-relaxed">Full privacy policy content coming soon. For questions, contact <a href="mailto:privacy@convoyfriends.app" class="text-cyan hover:underline">privacy@convoyfriends.app</a>.</p>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>
