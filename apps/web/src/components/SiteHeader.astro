---
---

<header class="fixed top-0 inset-x-0 z-50 border-b border-line-subtle bg-ground/80 backdrop-blur-md">
  <div class="mx-auto max-w-6xl px-6 h-14 flex items-center justify-between">
    <!-- Brand mark + name -->
    <a href="/" class="flex items-center gap-3 no-underline" aria-label="ConvoyFriends home">
      <span
        class="w-9 h-9 rounded-md bg-gradient-brand grid place-items-center shadow-brand-mark flex-shrink-0"
        aria-hidden="true"
      >
        <!-- paper-plane brand mark -->
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true">
          <polygon points="22 2 15 22 11 13 2 9" fill="white"/>
          <line x1="22" y1="2" x2="11" y2="13" stroke="white" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </span>
      <span class="font-display font-semibold text-lg tracking-tight">
        Convoy<span class="bg-gradient-brand bg-clip-text text-transparent">Friends</span>
      </span>
    </a>

    <!-- Beta pill + CTA -->
    <div class="flex items-center gap-3">
      <span class="hidden sm:inline-flex items-center gap-2 px-3 py-1 rounded-pill border border-line-subtle text-caption text-ink-mute">
        <span class="w-1.5 h-1.5 rounded-full bg-teal shadow-[0_0_0_3px_color-mix(in_srgb,var(--color-teal)_18%,transparent)]"></span>
        Beta open ·
        <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="#F2B26B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:inline;vertical-align:middle" aria-hidden="true">
          <path d="M3 18h18M5 16l-2-8 5 3 4-7 4 7 5-3-2 8H5z"/>
        </svg>
        <span style="color:#F2B26B;font-weight:600">VIP Group</span>
      </span>
      <a
        href="#apply"
        class="inline-flex items-center gap-2 px-4 py-2 rounded-md bg-gradient-brand text-ink-on-accent font-display font-bold text-small shadow-cta transition-[transform,filter] duration-fast ease-standard hover:-translate-y-px hover:brightness-105"
      >
        Apply now
        <svg viewBox="0 0 16 16" width="14" height="14" fill="none" aria-hidden="true">
          <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    </div>
  </div>
</header>
