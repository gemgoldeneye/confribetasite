{
  "name": "@confri/storybook",
  "version": "0.0.0",
  "private": true,
  "description": "Storybook for the ConvoyFriends web UI kit. Hosts every primitive in @confri/ui-web.",
  "type": "module",
  "scripts": {
    "dev": "storybook dev -p 6006 --no-open",
    "build": "storybook build",
    "typecheck": "tsc --noEmit",
    "loki": "loki test --requireReference",
    "loki:update": "loki update",
    "loki:approve": "loki approve"
  },
  "dependencies": {
    "@confri/ui-web": "workspace:*"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^8.4.0",
    "@storybook/blocks": "^8.4.0",
    "@storybook/react": "^8.4.0",
    "@storybook/react-vite": "^8.4.0",
    "@storybook/test": "^8.4.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "loki": "^0.35.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "storybook": "^8.4.0",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.0"
  },
  "loki": {
    "configurations": {
      "chrome.laptop": {
        "target": "chrome.docker",
        "width": 1440,
        "height": 900,
        "deviceScaleFactor": 1,
        "mobile": false
      }
    }
  }
}
